# Hugo Build Output
# Ignore the local public build folder. GitHub Actions will generate this dynamically on deployment.
/public/

# Hugo Cache & Assets
# Generated by Hugo asset pipelines (SASS compilation, image resizing, etc.)
/resources/_gen/
.hugo_build.lock

# JavaScript / Frontend Dependencies
# Only needed if you use npm/yarn for modern asset building or Tailwind CSS
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# System & OS Files
.DS_Store
Thumbs.db
ehthumbs.db

# IDEs and Code Editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment Variables & Secrets
# Keep API keys or webhook secrets private
.env
.env.local
.env.*.local

